# Private. A studio's library/ holds its book notes and stays on this disk
# only; text drawn from a book never lands in a tracked file or an issue.
# `bin/canary-check.sh` proves this holds; run it before every push.
/*/library/
*.epub

# Caches and local files
.DS_Store
.impeccable/
__pycache__/
.pytest_cache/
.venv/
.env
.claude/settings.local.json

# Each studio's local folder paths (private, per machine).
*/folders.local
